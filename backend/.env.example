# 复制为 .env 后填入真实值，.env 本身不会被 git 跟踪、不会被提交
# cp .env.example .env

# 当曲云登录账号（爬虫用，保持登录态抓取工单数据）
DANGQUYUN_USERNAME=
DANGQUYUN_PASSWORD=

# 要抓取的目标页面地址（工单中心 pagedetail 页）
DANGQUYUN_TARGET_URL=https://app.dangquyun.com/tabs/85954a1f-afda-4b6d-953c-eb558fe2d2b1/displayApp/4af791e8-ee54-40a0-a5a5-5a1a0504c03b/dynamicApp/4af791e8-ee54-40a0-a5a5-5a1a0504c03b/pagedetail/09e1a6c9-9397-4f75-8ffa-14c2b3af0ed3/host

# 当曲云登录页地址（不确定时可先留空，脚本会尝试从目标地址跳转后的登录页自动识别；
# 如果自动识别不准确，手动填入实际登录页 URL）
DANGQUYUN_LOGIN_URL=

# 调试模式：为 true 时无头浏览器改为有头（本地可看见浏览器操作过程），并在抓取失败时保存截图/HTML 到 backend/.auth/debug/
DANGQUYUN_DEBUG=false

# 默认复用本机已安装的 Chrome，不用单独下载 Playwright 自带 Chromium。
# 如果运行环境（比如服务器）没有装 Chrome，把这一项留空即可自动回退到 Playwright 自带内核
# （回退时需要先执行一次 npx playwright install chromium）
DANGQUYUN_BROWSER_CHANNEL=chrome

# ---- 「需方期望月度」下拉取值来源（默认值，管理员可在页面上修改并覆盖，覆盖结果存在 backend/.data/settings.json）----
# monthlyPlan：取自系统内工单的月度计划字段（默认）；generated：以当前月份为基准自动生成；custom：手工维护的月份清单
EXPECTED_MONTH_SOURCE_MODE=monthlyPlan

# monthlyPlan 模式：是否把子需求的月度计划也并入候选值
EXPECTED_MONTH_INCLUDE_SUB_TICKETS=true

# generated 模式：以当前月份为基准，往前/往后各生成多少个月（0-60）
EXPECTED_MONTH_PAST_MONTHS=3
EXPECTED_MONTH_FUTURE_MONTHS=12

# custom 模式：手工维护的月份清单，英文逗号分隔，格式 YYYY-MM
EXPECTED_MONTH_CUSTOM_MONTHS=

# 是否把已填写的期望月度并入候选值（来源收窄后历史值仍可选回，建议保持 true）
EXPECTED_MONTH_INCLUDE_EXISTING=true
